# 비밀 값과 이 맥에만 해당하는 값. 앱마다 다른 값은 farm.config.ts에 둔다.

# 앱 설정 파일 경로(비우면 작업 폴더의 farm.config.ts → farm.config.example.ts)
FARM_CONFIG=
# 화면 서버 포트(비우면 5173)
FARM_PORT=
# 화면 언어 ko·en(비우면 farm.config.ts의 locale, 그것도 없으면 ko)
FARM_LOCALE=
# farm.config.ts의 web·apiOrigin을 이 맥에서만 덮을 때
FARM_WEB_ORIGIN_DEV=
FARM_WEB_ORIGIN_PROD=
FARM_API_ORIGIN=
# 탐색 허용 목록 후보를 뽑을 OpenAPI 스펙 주소(npm run explore-allowlist)
FARM_OPENAPI_URL=
# 디바이스팜 화면에 들어올 수 있는 Tailscale 계정 도메인(쉼표). 비우면 farm.config.ts의 access.allowedDomains
FARM_ALLOWED_DOMAINS=

# Firebase App Distribution(빌드 받기·새 빌드 감시). 앱 id는 farm.config.ts install.firebase로도 줄 수 있다
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_APP_ANDROID_DEV=
FIREBASE_APP_ANDROID_PROD=
FIREBASE_APP_IOS_DEV=
FIREBASE_APP_IOS_PROD=

# App Store Connect(TestFlight 새 빌드 감시, 읽기만)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=
ASC_APP_ID=
ASC_APP_ID_DEV=

# iOS Appium·WebDriverAgent. 팀 id가 비면 서명 설정 없이 세션을 연다
APPIUM_URL=
IOS_TEAM_ID=
IOS_WDA_BUNDLE_ID=

# 플로우 생성: PRD를 읽을 프론트 체크아웃, OpenAI 호환 LLM
FLOW_PRD_ROOT=
FLOW_LLM_API_KEY=
FLOW_LLM_BASE_URL=
FLOW_LLM_MODEL=

# 정책·피그마 대조(읽기 전용). cloudId·스페이스는 farm.config.ts policy.confluence로도 줄 수 있다
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_CLOUD_ID=
CONFLUENCE_SPACE_KEY=
FIGMA_TOKEN=
# 프론트 배포 브랜치(비우면 farm.config.ts figma.ref)
FARM_FRONT_REF=
# QA 계정 주인 이름(쉼표). 화면에 나오는 이름은 피그마 차이 알림·아침 분석에서 거른다
FARM_ACCOUNT_NAME=
# 기록 DB 경로(비우면 test-results/farm.db)
FARM_DB=

# 사내망 접속(선택): 넷 다 채우면 같은 망 PC가 HTTPS + 팀 비밀번호로 들어온다. 비우면 127.0.0.1에 http(밖에서는 tailscale serve)
# 디바이스팜 주소. 예: https://farm-host.local:5173
FARM_PUBLIC_ORIGIN=
# 인증서·키 경로(mkcert 등). CLI는 NODE_EXTRA_CA_CERTS로 그 루트 인증서를 믿게 한다
FARM_TLS_CERT=
FARM_TLS_KEY=
# 팀 비밀번호 scrypt 해시. npx device-farm farm-password 로 만든다(비밀번호 자체는 넣지 않는다). 있으면 Tailscale 계정 대신 이 로그인이 관문이다
FARM_PASSWORD_HASH=

# 슬랙 알림(선택). 봇 토큰이 없으면 보내지 않는다. 앱 토큰(Socket Mode)이 있어야 알림 버튼(처리 완료·문제 아님·수정 PR)을 받는다
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# dev 점검·봇·탐색 끝 알림·아침 분석 채널 id / prod 점검 채널 id
SLACK_CHANNEL_DEV=
SLACK_CHANNEL_PROD=

# 야간 점검(03:00 플로우·03:30 봇)을 서버가 돌린다. 1이면 켠다
FARM_NIGHTLY=
# 평일 09:00 Claude 아침 분석(저장 + SLACK_CHANNEL_DEV). 1이면 켠다. Claude Code 로그인(CLAUDE_CODE_OAUTH_TOKEN)이 필요하다
FARM_DAILY_REPORT=
CLAUDE_CODE_OAUTH_TOKEN=

# 슬랙 오류 알림의 「수정 PR 만들기」(선택). 토큰·레포가 둘 다 있어야 켜진다. Claude Code가 레포를 고쳐 PR을 연다
# GitHub 토큰(contents·pull requests 쓰기)
FARM_FIX_PR_GITHUB_TOKEN=
# 앱 웹 프론트 레포 owner/name
FARM_FIX_PR_REPO=
# PR을 열 base 브랜치(쉼표, 첫 번째가 수정 기준·나머지는 cherry-pick). 비우면 main
FARM_FIX_PR_BASES=

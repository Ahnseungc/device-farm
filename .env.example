# 비밀 값과 이 맥에만 해당하는 값. 앱마다 다른 값은 farm.config.ts에 둔다.

# 앱 설정 파일 경로(비우면 작업 폴더의 farm.config.ts → farm.config.example.ts)
FARM_CONFIG=
# 화면 서버 포트(비우면 5173)
FARM_PORT=
# 화면 언어 ko·en(비우면 farm.config.ts의 locale, 그것도 없으면 ko)
FARM_LOCALE=
# farm.config.ts의 web·apiOrigin을 이 맥에서만 덮을 때
FARM_WEB_ORIGIN_DEV=
FARM_WEB_ORIGIN_PROD=
FARM_API_ORIGIN=
# 탐색 허용 목록 후보를 뽑을 OpenAPI 스펙 주소(npm run explore-allowlist)
FARM_OPENAPI_URL=
# 디바이스팜 화면에 들어올 수 있는 Tailscale 계정 도메인(쉼표). 비우면 farm.config.ts의 access.allowedDomains
FARM_ALLOWED_DOMAINS=

# Firebase App Distribution(빌드 받기·새 빌드 감시). 앱 id는 farm.config.ts install.firebase로도 줄 수 있다
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_APP_ANDROID_DEV=
FIREBASE_APP_ANDROID_PROD=
FIREBASE_APP_IOS_DEV=
FIREBASE_APP_IOS_PROD=

# App Store Connect(TestFlight 새 빌드 감시, 읽기만)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=
ASC_APP_ID=
ASC_APP_ID_DEV=

# iOS Appium·WebDriverAgent. 팀 id가 비면 서명 설정 없이 세션을 연다
APPIUM_URL=
IOS_TEAM_ID=
IOS_WDA_BUNDLE_ID=

# 플로우 생성: PRD를 읽을 프론트 체크아웃, OpenAI 호환 LLM
FLOW_PRD_ROOT=
FLOW_LLM_API_KEY=
FLOW_LLM_BASE_URL=
FLOW_LLM_MODEL=

# 정책·피그마 대조(읽기 전용). cloudId·스페이스는 farm.config.ts policy.confluence로도 줄 수 있다
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_CLOUD_ID=
CONFLUENCE_SPACE_KEY=
FIGMA_TOKEN=
# 프론트 배포 브랜치(비우면 farm.config.ts figma.ref)
FARM_FRONT_REF=
